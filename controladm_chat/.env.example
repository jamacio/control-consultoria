# Docker: porta do site (diferente para cada site no mesmo servidor) e nome da imagem
PORT=4000
DOCKER_IMAGE=ldv-chat
ADMIN_USER=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=aaaaaaaaaaaaaaaaaaaa.aaaaa
GEMINI_MODEL=gemini-flash-lite-latest

# Idioma das respostas da IA no chat, em inglês (ex: Brazilian Portuguese, English, Spanish)
RESPONSE_LANGUAGE=Brazilian Portuguese

# Limites para a conta da API: pedidos por dia, tamanho da mensagem e da resposta da IA
DAILY_LIMIT=50
MAX_MESSAGE_CHARS=400
MAX_POST_CHARS=2000
MAX_OUTPUT_TOKENS=800
